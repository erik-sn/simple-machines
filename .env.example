# Copy to .env for local development (just setup does this). Every variable is
# REQUIRED at startup unless marked optional - missing config fails by name.
# mise loads .env automatically (see mise.toml).

DJANGO_SECRET_KEY=insecure-local-development-key-0000
# dev | staging | production. Drives DEBUG (dev only), dev-only conveniences
# (the dev/dev superuser), and Sentry's environment tag.
ENVIRONMENT=dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches compose.yaml and the CI service containers. Every checkout on a
# machine (worktrees, a second generated project) binds these host ports, so
# give each its own block: change POSTGRES_PORT, REDIS_PORT, BACKEND_PORT,
# FRONTEND_PORT, the E2E_* four, and the port inside REDIS_URL and
# CACHE_REDIS_URL together. `just dev-down` frees a block.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Compose only (the app reads the URLs below): host port of the Redis container.
REDIS_PORT=6379
# Dev servers: Django (just dev-backend) and Vite (just dev-frontend).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# The end-to-end suite's own block: `just e2e` starts db-e2e and redis-e2e on
# the first two and runs the app servers on the last two, so it never touches
# the dev stores and never needs `just dev-backend` to stop.
E2E_POSTGRES_PORT=5442
E2E_REDIS_PORT=6389
E2E_BACKEND_PORT=8010
E2E_FRONTEND_PORT=5183
# One Redis instance, two DB indexes: 0 is the Celery broker and result
# backend, 1 is the Django cache. The index scopes FLUSHDB (cache.clear()
# cannot flush the broker); it is not memory isolation.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1

# Optional: server-side statement timeout in milliseconds for this process.
# The web Deployment sets 10000; worker, beat, and migrations run unbounded.
# STATEMENT_TIMEOUT_MS=0

# Optional: error tracking activates only when set.
# SENTRY_DSN=
